001001000 // 00: mvi  R1, #1
000000001 // 01: #1
001010000 // 02: mvi  R2, #0
000000000 // 03: #0
001011000 // 04: Loop: mvi R3, #010000000
010000000 // 05: #0x080 (LEDs address)
101010011 // 06: st   R2, R3
010010001 // 07: add  R2, R1
001011000 // 08: mvi  R3, #111111111
111111111 // 09: #511
000101111 // 0A: mv   R5, R7
001100000 // 0B: Outer: mvi R4, #111111111
111111111 // 0C: #511
000000111 // 0D: mv   R0, R7
011100001 // 0E: Inner: sub R4, R1
110111000 // 0F: mvnz R7, R0
011011001 // 10: sub  R3, R1
110111101 // 11: mvnz R7, R5
001111000 // 12: mvi  R7, #Loop
000000100 // 13: #0x04
